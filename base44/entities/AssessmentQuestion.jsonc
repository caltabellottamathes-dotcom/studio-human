{
  "name": "AssessmentQuestion",
  "type": "object",
  "properties": {
    "question_text": {
      "type": "string"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "single",
        "multiple"
      ],
      "default": "single"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "answers": {
      "type": "string",
      "description": "JSON-encoded array of { text: string, profile_weights: { [profile_key]: number } }"
    }
  },
  "required": [
    "question_text",
    "question_type",
    "answers"
  ]
}