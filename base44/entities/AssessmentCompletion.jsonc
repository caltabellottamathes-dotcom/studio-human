{
  "name": "AssessmentCompletion",
  "type": "object",
  "properties": {
    "profile_key": {
      "type": "string"
    },
    "answers_summary": {
      "type": "string",
      "description": "JSON-encoded summary of selected answer texts"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "profile_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}