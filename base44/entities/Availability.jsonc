{
  "name": "Availability",
  "type": "object",
  "properties": {
    "day_of_week": {
      "type": "number",
      "description": "0 = Sunday, 6 = Saturday"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "is_available": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "day_of_week",
    "start_time",
    "end_time"
  ]
}