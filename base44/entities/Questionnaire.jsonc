{
  "name": "Questionnaire",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Null for templates, set when assigned to a client"
    },
    "client_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "questions": {
      "type": "string",
      "description": "JSON-encoded array of question objects"
    },
    "responses": {
      "type": "string",
      "description": "JSON-encoded array of response objects, null until completed"
    },
    "status": {
      "type": "string",
      "enum": [
        "template",
        "assigned",
        "completed"
      ],
      "default": "assigned"
    },
    "assigned_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title",
    "questions"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}