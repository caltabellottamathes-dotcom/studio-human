{
  "name": "ContactRequest",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "struggle": {
      "type": "string",
      "description": "Selected zorgvraag category from the contact form"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "waiting",
        "responded"
      ],
      "default": "new"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email",
    "message"
  ]
}